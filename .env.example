# Шаблон переменных окружения для Analysis Core.
# Скопировать в .env и заполнить РЕАЛЬНЫМИ значениями руками.
# .env в git НЕ коммитится (см. .gitignore). Здесь только плейсхолдеры.
#
# Применение (bash/zsh):
#   cp .env.example .env      # затем вписать значения
#   set -a; source .env; set +a
#   python run_review.py ...

# Эндпоинт локальной LLM (Ollama, OpenAI-совместимый). БЕЗ реального адреса в репозитории.
# Пример формата: http://<HOST>:11434/api/chat
OLLAMA_URL=http://localhost:11434/api/chat

# Имя модели.
OLLAMA_MODEL=qwen3:30b-a3b

# PostgreSQL для Docker Compose. Скопируйте файл в `.env` и задайте длинный
# случайный URL-safe пароль (буквы и цифры): одно значение используется и
# контейнером PostgreSQL, и строкой подключения приложения. Пустое значение
# намеренно не имеет небезопасного fallback — Compose откажется запускаться.
DOCREVIEW_POSTGRES_DB=docreview
DOCREVIEW_POSTGRES_USER=docreview
DOCREVIEW_POSTGRES_PASSWORD=

# Необязательные локальные имена артефактов Docker.
DOCREVIEW_POSTGRES_VOLUME=docreview-postgres-data
DOCREVIEW_DOCUMENTS_VOLUME=docreview-documents
DOCREVIEW_RUNS_VOLUME=docreview-runs
DOCREVIEW_ARTIFACTS_VOLUME=docreview-artifacts
DOCREVIEW_STATE_VOLUME=docreview-state
DOCREVIEW_BACKEND_IMAGE_TAG=local
