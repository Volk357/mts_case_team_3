# Шаблон переменных окружения для Analysis Core.
# Скопировать в .env и заполнить РЕАЛЬНЫМИ значениями руками.
# .env в git НЕ коммитится (см. .gitignore). Здесь только плейсхолдеры.
#
# Применение (bash/zsh):
#   cp .env.example .env      # затем вписать значения
#   set -a; source .env; set +a
#   python run_review.py ...

# Эндпоинт локальной LLM (Ollama, OpenAI-совместимый). БЕЗ реального адреса в репозитории.
# Пример формата: http://<HOST>:11434/api/chat
OLLAMA_URL=http://localhost:11434/api/chat

# Имя модели.
OLLAMA_MODEL=qwen3:30b-a3b
