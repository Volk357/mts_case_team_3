DOCREVIEW_APP_NAME=DocReview API
DOCREVIEW_ENVIRONMENT=development
DOCREVIEW_API_PREFIX=/api
DOCREVIEW_LOG_LEVEL=DEBUG
DOCREVIEW_DATABASE_URL=postgresql+psycopg://docreview@localhost/docreview
DOCREVIEW_DOCUMENTS_DIR=data/documents
DOCREVIEW_RUNS_DIR=data/runs
DOCREVIEW_ARTIFACTS_DIR=data/artifacts
DOCREVIEW_REVIEW_PACKS_DIR=review-packs
DOCREVIEW_ANALYSIS_EXECUTABLE=docreview
DOCREVIEW_ANALYSIS_MODEL_CONFIG_PATH=model-config.yaml
DOCREVIEW_PROCESS_STDOUT_LIMIT_BYTES=5242880
DOCREVIEW_PROCESS_STDERR_LIMIT_BYTES=262144
DOCREVIEW_ANALYSIS_TIMEOUT_SECONDS=600
DOCREVIEW_PROCESS_TERMINATION_GRACE_SECONDS=5
DOCREVIEW_WORKER_POLL_INTERVAL_SECONDS=1
DOCREVIEW_REVIEW_POLL_INTERVAL_SECONDS=2
DOCREVIEW_WORKER_STALE_AFTER_SECONDS=900
DOCREVIEW_REVIEW_RESULT_SCHEMA_PATH=contracts/review-result.schema.json
DOCREVIEW_MAX_REVIEW_RESULT_SIZE_BYTES=10485760
DOCREVIEW_MAX_UPLOAD_SIZE_BYTES=52428800
DOCREVIEW_MAX_REQUEST_SIZE_BYTES=57671680
DOCREVIEW_RATE_LIMIT_REQUESTS=120
DOCREVIEW_RATE_LIMIT_WINDOW_SECONDS=60
DOCREVIEW_DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
DOCREVIEW_DEFAULT_COMPANY_SLUG=local-mvp
DOCREVIEW_DEFAULT_COMPANY_NAME=Local MVP Company
DOCREVIEW_ORPHAN_UPLOAD_GRACE_PERIOD_HOURS=24
DOCREVIEW_DOCUMENT_RETENTION_DAYS=90
DOCREVIEW_ARTIFACT_RETENTION_DAYS=14
DOCREVIEW_AUTOMATIC_RETENTION_ENABLED=false
DOCREVIEW_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
