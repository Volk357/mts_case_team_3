{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docreview.local/contracts/review-result/1.0/schema.json",
  "title": "DocReview ReviewResult",
  "description": "Version 1.x contract returned by Analysis Core to Product Application.",
  "oneOf": [
    { "$ref": "#/$defs/completed_result" },
    { "$ref": "#/$defs/failed_result" }
  ],
  "$defs": {
    "completed_result": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "status",
        "document",
        "engine",
        "review_pack",
        "model",
        "findings",
        "summary",
        "warnings",
        "timings"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/run_id" },
        "status": { "const": "completed" },
        "document": { "$ref": "#/$defs/document" },
        "engine": { "$ref": "#/$defs/engine" },
        "review_pack": { "$ref": "#/$defs/review_pack" },
        "model": { "$ref": "#/$defs/model" },
        "findings": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/finding" }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "timings": { "$ref": "#/$defs/timings" }
      },
      "not": { "required": ["error"] },
      "additionalProperties": true
    },
    "failed_result": {
      "type": "object",
      "required": ["schema_version", "run_id", "status", "error"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "run_id": { "$ref": "#/$defs/run_id" },
        "status": { "const": "failed" },
        "error": { "$ref": "#/$defs/error" }
      },
      "additionalProperties": true
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "document": {
      "type": "object",
      "required": ["filename", "document_type", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": true
    },
    "review_pack": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["name", "prompt_versions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "prompt_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "location": {
      "type": "object",
      "required": ["page", "section_path", "block_id"],
      "properties": {
        "page": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "section_path": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "block_id": { "type": "string", "minLength": 1 },
        "table": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "row": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "column": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "bbox": {
          "oneOf": [
            {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number", "minimum": 0 },
                "y": { "type": "number", "minimum": 0 },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "defect_id",
        "severity",
        "confidence",
        "location",
        "quote",
        "problem",
        "clarification",
        "detected_by"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "defect_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "location": { "$ref": "#/$defs/location" },
        "quote": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "clarification": { "type": "string", "minLength": 1 },
        "detected_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "total_candidates",
        "verified_candidates",
        "returned_findings",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total_candidates": { "type": "integer", "minimum": 0 },
        "verified_candidates": { "type": "integer", "minimum": 0 },
        "returned_findings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "warning": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      ]
    },
    "timings": {
      "type": "object",
      "required": ["total_ms"],
      "properties": {
        "total_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "stage", "message", "retriable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retriable": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
